# F18. Скопируй файл под ту среду, где запускаешься:
#   .env.development  — использует `npm run dev`
#   .env.production   — использует `npm run build`
# Значения подставит Vite через import.meta.env.VITE_*.
#
# Для локальной разработки backend слушает на 5000 (см. CLAUDE.md).
# Для production укажи публичный URL API-домена; если фронт и бэк на
# одном домене за nginx-прокси — можно оставить относительный путь
# (пустое значение или "/") и настроить nginx.conf.example.
#
# ВАЖНО: HTTPS обязателен на production — без него навигационная
# геолокация (F5) и Service Worker'ы отключаются браузером.

VITE_API_BASE_URL=http://localhost:5000

# F22. Версия в футере профиля / админ-sidebar. По умолчанию считается
# АВТОМАТИЧЕСКИ при сборке (короткий git-SHA + дата, см. vite.config.ts),
# поэтому обычно эту переменную задавать НЕ нужно — не ставьте её, и версия
# будет обновляться каждым деплоем сама. Задайте явно, только если хотите
# зафиксировать строку (например, релизный тег) — она имеет приоритет.
# VITE_APP_VERSION=

# F27. Fallback URL для кнопки «Скачать APK» на /download, когда
# GET /api/app/version недоступен или не отдаёт downloadUrl. В проде
# ставим публичный URL актуальной сборки APK; в dev можно оставить
# заглушку — юзер увидит 404 при клике.
VITE_APK_FALLBACK_URL=https://gdeoni.ru/apk/latest.apk

# F18. Nginx-конфиг для prod: статика фронта + reverse-proxy к API
# на том же домене. При деплое скопируй как /etc/nginx/sites-available/
# gdeoni.conf, подставь свои значения (server_name, ssl-сертификаты,
# upstream backend, dist-путь) и подключи через symlink в
# sites-enabled/.
#
# Ключевые моменты:
#  1) Одинаковый origin для фронта и /api — экономит CORS-настройку
#     на бэке и cookie-based auth (даже если сейчас у нас Bearer,
#     на будущее remove-list проще).
#  2) try_files для SPA-роутинга — 404 отдают index.html, чтобы
#     React Router разобрал путь клиентом.
#  3) HSTS + HTTP → HTTPS редирект. Без HTTPS navigator.geolocation
#     не работает в prod-браузерах.
#  4) proxy_pass keeps host header — бэк JWT-проверка полагается
#     на настроенный Issuer/Audience.

# HTTP → HTTPS redirect.
server {
    listen 80;
    listen [::]:80;
    server_name gdeoni.example.com;

    return 301 https://$server_name$request_uri;
}

# HTTPS: фронт + API proxy.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name gdeoni.example.com;

    ssl_certificate     /etc/letsencrypt/live/gdeoni.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gdeoni.example.com/privkey.pem;

    # HSTS: минимум 6 месяцев (нужен для 100% доверия к geolocation
    # без всплывающих подсказок про небезопасное соединение).
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;

    # Статика фронта: собранный `dist/` после `npm run build`.
    root /var/www/gdeoni/dist;
    index index.html;

    # Кеш immutable-ассетов: Vite добавляет content-hash в имена
    # (index-XXXX.js), поэтому годичный кеш безопасен.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Reverse-proxy /api → backend. Upstream — ASP.NET Kestrel на 5000.
    location /api/ {
        proxy_pass         http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;

        # WebSocket / SSE не используются (пока), но keep-alive не мешает.
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;

        # Загрузка media (10МБ фото / 25МБ документов) — увеличиваем
        # лимит и таймаут на большой upload.
        client_max_body_size 30M;
        proxy_read_timeout   120s;
    }

    # SPA-роутинг: любой неизвестный путь → index.html, React Router
    # разберёт клиентски. Порядок важен: сначала пробуем реальный
    # файл, потом директорию, потом fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Для WebSocket-заголовков (используется даже если сейчас нет ws).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             x:Class="GdeOni.Mobile.Views.Auth.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Восстановление пароля">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,60,24,40" Spacing="24">

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Где Они"
                           FontSize="40"
                           FontAttributes="Bold"
                           TextColor="{StaticResource InkBlue}"
                           HorizontalOptions="Center" />
                    <Label Text="восстановление доступа"
                           Style="{StaticResource CaptionLabel}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Форма запроса ссылки -->
                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding IsFormVisible}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Забыли пароль"
                               Style="{StaticResource SubTitleLabel}" />

                        <Label Text="Укажите email, на который зарегистрирован аккаунт. Мы отправим на него ссылку для установки нового пароля."
                               Style="{StaticResource BodyLabel}" />

                        <Entry Placeholder="Email"
                               Style="{StaticResource FormEntry}"
                               Keyboard="Email"
                               Text="{Binding Email}" />

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               TextColor="#C0392B"
                               FontSize="13" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Azure}" />

                        <Button Text="Отправить ссылку"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding IsNotBusy}" />

                        <Button Text="Назад ко входу"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding BackToLoginCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Экран «проверьте почту». Формулировка условная:
                     бэк намеренно отвечает одинаково для существующих и
                     несуществующих адресов, и интерфейс не должен
                     выдавать разницу. -->
                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding IsSent}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="📬"
                               FontSize="40"
                               HorizontalOptions="Center" />

                        <Label Style="{StaticResource BodyLabel}"
                               HorizontalTextAlignment="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Если аккаунт с адресом " />
                                    <Span Text="{Binding Email}" FontAttributes="Bold" />
                                    <Span Text=" существует, мы отправили на него письмо со ссылкой для смены пароля." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Text="Откройте ссылку из письма — она откроется в браузере, там и задаёте новый пароль. Ссылка действует ограниченное время. Не пришло письмо — проверьте папку «Спам»."
                               Style="{StaticResource CaptionLabel}"
                               HorizontalTextAlignment="Center" />

                        <Button Text="Вернуться ко входу"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding BackToLoginCommand}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

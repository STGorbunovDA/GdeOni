<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             x:Class="GdeOni.Mobile.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,80,24,40" Spacing="24">

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Где Они"
                           FontSize="44"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource InkBlue}, Dark={StaticResource InkBlueDark}}"
                           HorizontalOptions="Center" />
                    <Label Text="помним. находим. бережём."
                           Style="{StaticResource CaptionLabel}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Вход в аккаунт"
                               Style="{StaticResource SubTitleLabel}" />

                        <Entry Placeholder="Email"
                               Style="{StaticResource FormEntry}"
                               Keyboard="Email"
                               Text="{Binding Email}" />

                        <Entry Placeholder="Пароль"
                               Style="{StaticResource FormEntry}"
                               IsPassword="True"
                               Text="{Binding Password}" />

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               TextColor="#C0392B"
                               FontSize="13" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Azure}" />

                        <Button Text="Войти"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotBusy}" />

                        <Button Text="Создать аккаунт"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding GoToRegisterCommand}"
                                IsEnabled="{Binding IsNotBusy}" />

                        <!-- D43. Восстановление пароля. -->
                        <Button Text="Забыли пароль?"
                                Style="{StaticResource GhostButton}"
                                FontSize="14"
                                Command="{Binding GoToForgotPasswordCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- E27. Быстрый переключатель темы (солнце/луна), как на вебе.
             Плавает в правом верхнем углу поверх шапки. -->
        <Label Text="{Binding ThemeIcon}"
               FontSize="24"
               Padding="10"
               HorizontalOptions="End"
               VerticalOptions="Start"
               Margin="0,40,12,0">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleThemeCommand}" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>

</ContentPage>

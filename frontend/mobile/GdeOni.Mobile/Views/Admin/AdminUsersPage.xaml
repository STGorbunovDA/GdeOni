<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             x:Class="GdeOni.Mobile.Views.Admin.AdminUsersPage"
             x:DataType="vm:AdminUsersViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Пользователи">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,40" Spacing="14">

                <Button Text="‹ Назад"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"
                        Padding="16,8" />

                <Label Text="Пользователи" Style="{StaticResource TitleLabel}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Grid.Column="0"
                           Placeholder="Поиск по email/имени"
                           Text="{Binding SearchText}" />
                    <Button Grid.Column="1"
                            Text="Найти"
                            Style="{StaticResource PrimaryButton}"
                            Padding="14,6"
                            Command="{Binding LoadFirstPageCommand}" />
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Azure}" />

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="#C0392B"
                       Style="{StaticResource BodyLabel}" />

                <Label Text="Пользователей нет."
                       Style="{StaticResource CaptionLabel}"
                       IsVisible="{Binding HasNoItems}" />

                <CollectionView ItemsSource="{Binding Users}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdminUserItem">
                            <Border Style="{StaticResource CloudCard}" Margin="0,0,0,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminUsersViewModel}}, Path=OpenUserCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowSpacing="2">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding DisplayName}"
                                               Style="{StaticResource SubTitleLabel}"
                                               FontSize="16" />
                                        <Label Text="{Binding Email}"
                                               Style="{StaticResource CaptionLabel}" />
                                        <Label Text="{Binding Role, StringFormat='Роль: {0}'}"
                                               Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                        <Label Text="{Binding TrackingCount, StringFormat='Отслеж.: {0}'}"
                                               Style="{StaticResource CaptionLabel}" />
                                        <Label Text="{Binding Registered, StringFormat='Рег.: {0}'}"
                                               Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Загрузить ещё"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding LoadNextPageCommand}"
                        IsVisible="{Binding CanLoadMore}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GdeOni.Mobile.Views.Admin.AdminUserDetailsPage"
             x:DataType="vm:AdminUserDetailsViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Пользователь">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBool" />
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,40" Spacing="16">

                <Button Text="‹ Назад"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"
                        Padding="16,8" />

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Azure}" />

                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding HasStatus}"
                       TextColor="#2E7D32"
                       Style="{StaticResource BodyLabel}" />

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="#C0392B"
                       Style="{StaticResource BodyLabel}" />

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding DisplayName}" Style="{StaticResource TitleLabel}" FontSize="22" />
                        <Label Text="{Binding Email}" Style="{StaticResource CaptionLabel}" />
                        <Label Text="{Binding Role, StringFormat='Текущая роль: {0}'}" Style="{StaticResource BodyLabel}" />
                        <Label Text="{Binding Registered, StringFormat='Регистрация: {0}'}" Style="{StaticResource CaptionLabel}" />
                        <Label Text="{Binding TrackingCount, StringFormat='Отслеживает: {0}'}" Style="{StaticResource CaptionLabel}" />
                        <Button Text="Управление отслеживаниями"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding OpenTrackedCommand}"
                                HorizontalOptions="Start"
                                Padding="14,6"
                                FontSize="13"
                                Margin="0,8,0,0"
                                IsVisible="{Binding CanManageTarget}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Текущая подписка" Style="{StaticResource SubTitleLabel}" />
                        <Label Text="{Binding SubscriptionStatusDisplay}" Style="{StaticResource BodyLabel}" />
                        <Label Text="{Binding SubscriptionDetails}"
                               Style="{StaticResource CaptionLabel}" />
                        <Label Text="{Binding ComplimentaryDisplay, StringFormat='Бесплатный доступ: {0}'}"
                               Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Если я Admin и target — Admin/SuperAdmin, все блоки
                     управления скрыты. Бэк всё равно отдаст 403. -->
                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding CanManageTarget}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Сменить роль" Style="{StaticResource SubTitleLabel}" />
                        <Picker ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" />
                        <Button Text="Применить роль"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ChangeRoleCommand}"
                                IsEnabled="{Binding IsBusyAction, Converter={StaticResource InvertedBool}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding CanManageTarget}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Бесплатный доступ (бессрочно)" Style="{StaticResource SubTitleLabel}" />
                        <Label Text="Юзер получает доступ ко всем функциям без подписки. Можно отозвать в любой момент."
                               Style="{StaticResource CaptionLabel}" />
                        <Editor Placeholder="Причина (необязательно)"
                                Text="{Binding ComplimentaryNote}"
                                AutoSize="TextChanges"
                                BackgroundColor="{StaticResource Cloud}" />
                        <Button Text="Сделать бессрочным"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GrantComplimentaryCommand}"
                                IsEnabled="{Binding IsBusyAction, Converter={StaticResource InvertedBool}}" />
                        <Button Text="Убрать бессрочный доступ"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding RevokeComplimentaryCommand}"
                                IsEnabled="{Binding IsBusyAction, Converter={StaticResource InvertedBool}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding CanManageTarget}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Подписка" Style="{StaticResource SubTitleLabel}" />
                        <Label Text="Восстановить пробный период на 30 дней — статус заменится на Trial."
                               Style="{StaticResource CaptionLabel}" />
                        <Button Text="Восстановить Trial (30 дней)"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RestartTrialCommand}"
                                IsEnabled="{Binding IsBusyAction, Converter={StaticResource InvertedBool}}" />
                        <Label Text="Принудительно снять активную подписку (Status → Expired). Доступ закроется при следующем запросе."
                               Style="{StaticResource CaptionLabel}"
                               Margin="0,8,0,0" />
                        <Button Text="Снять подписку"
                                Style="{StaticResource GhostButton}"
                                BackgroundColor="#C0392B"
                                TextColor="White"
                                Command="{Binding RevokeSubscriptionCommand}"
                                IsEnabled="{Binding IsBusyAction, Converter={StaticResource InvertedBool}}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

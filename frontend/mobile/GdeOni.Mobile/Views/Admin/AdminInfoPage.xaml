<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             x:Class="GdeOni.Mobile.Views.Admin.AdminInfoPage"
             x:DataType="vm:AdminInfoViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Информация">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,40" Spacing="14">

                <Button Text="‹ Назад"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"
                        Padding="16,8" />

                <Label Text="Информация" Style="{StaticResource TitleLabel}" />
                <Label Text="Сводка по системе. Только справка — ничего изменить отсюда нельзя."
                       Style="{StaticResource CaptionLabel}" />

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Azure}" />

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="#C0392B"
                       Style="{StaticResource BodyLabel}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdminStatSection">
                            <VerticalStackLayout Spacing="8" Margin="0,6,0,12">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource SubTitleLabel}"
                                       FontSize="16" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Metrics}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AdminStatMetric">
                                            <Border Style="{StaticResource CloudCard}">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Value}"
                                                           FontFamily="MontserratBold"
                                                           FontSize="24"
                                                           VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource AzureDeep}, Dark={StaticResource AzureDeepDark}}" />
                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Spacing="2"
                                                                         VerticalOptions="Center">
                                                        <Label Text="{Binding Label}"
                                                               Style="{StaticResource BodyLabel}" />
                                                        <Label Text="{Binding Hint}"
                                                               IsVisible="{Binding HasHint}"
                                                               Style="{StaticResource CaptionLabel}"
                                                               FontSize="12" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding GeneratedAt}"
                       IsVisible="{Binding HasGeneratedAt}"
                       Style="{StaticResource CaptionLabel}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             x:Class="GdeOni.Mobile.Views.Admin.AdminPage"
             x:DataType="vm:AdminViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Title="Админка">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,40" Spacing="20">

                <Button Text="‹ Назад"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"
                        Padding="16,8" />

                <Label Text="Админка" Style="{StaticResource TitleLabel}" />
                <Label Text="Управление пользователями, платежами и историей правок."
                       Style="{StaticResource CaptionLabel}" />

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="История правок" Style="{StaticResource SubTitleLabel}" />
                        <Label Text="Лента всех изменений карточек умерших по всей системе." Style="{StaticResource CaptionLabel}" />
                        <Button Text="Открыть"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenAllEditsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Пользователи" Style="{StaticResource SubTitleLabel}" />
                        <Label Text="Список пользователей, смена ролей, выдача бесплатного доступа." Style="{StaticResource CaptionLabel}" />
                        <Button Text="Открыть"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenAdminUsersCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Платежи" Style="{StaticResource SubTitleLabel}" />
                        <Label Text="История всех платежей подписки." Style="{StaticResource CaptionLabel}" />
                        <Button Text="Открыть"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenAdminPaymentsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- D44. Только владелец сервиса: в переписке платёжные
                     реквизиты и договорённости о переводах. -->
                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding IsSuperAdmin}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Обращения" Style="{StaticResource SubTitleLabel}" />
                        <Label Text="Обращения пользователей и автоматические инциденты." Style="{StaticResource CaptionLabel}" />
                        <Button Text="Открыть"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenAdminSupportCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- D27. Поиск умершего по всем характеристикам и просмотр
                     карточки без добавления в отслеживание. Полный admin-
                     контроль над медиа и верификацией. -->
                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Найти умершего" Style="{StaticResource SubTitleLabel}" />
                        <Label Text="Поиск по имени, датам, городу, координатам и пр. Полный просмотр без подписки." Style="{StaticResource CaptionLabel}" />
                        <Button Text="Открыть"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenAdminFindDeceasedCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- F38. Справка-сводка по системе: люди, карточки, контент,
                     обращения, деньги. Зеркало веб-раздела «Информация». -->
                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Информация" Style="{StaticResource SubTitleLabel}" />
                        <Label Text="Сводка по системе: люди, карточки, контент, обращения, платежи." Style="{StaticResource CaptionLabel}" />
                        <Button Text="Открыть"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenAdminInfoCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Версия установленного приложения — для сверки, что реально
                     стоит на телефоне (отладка обновлений). Только на мобилке. -->
                <Label Text="{Binding AppVersionDisplay}"
                       Style="{StaticResource CaptionLabel}"
                       HorizontalOptions="Center"
                       Margin="0,4,0,8" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

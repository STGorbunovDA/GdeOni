<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             xmlns:vmsup="clr-namespace:GdeOni.Mobile.ViewModels.Support"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GdeOni.Mobile.Views.Admin.AdminSupportDetailsPage"
             x:DataType="vm:AdminSupportDetailsViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Обращение">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBool" />
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,40" Spacing="14">

                <Button Text="‹ Назад"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"
                        Padding="16,8" />

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Azure}" />

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="#C0392B"
                       Style="{StaticResource BodyLabel}" />

                <!-- Header: title + текущие status/severity -->
                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Title}"
                               Style="{StaticResource TitleLabel}"
                               FontSize="20" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding KindDisplay}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding CurrentSeverityDisplay}"
                                   TextColor="{Binding CurrentSeverityColor}"
                                   FontAttributes="Bold" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding SourceDisplay}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding CurrentStatusDisplay}"
                                   TextColor="{Binding CurrentStatusColor}"
                                   FontAttributes="Bold" />
                        </Grid>

                        <Label Text="{Binding CreatedAt, StringFormat='Создано: {0}'}"
                               Style="{StaticResource CaptionLabel}" />
                        <Label Text="{Binding UpdatedAt, StringFormat='Обновлено: {0}'}"
                               IsVisible="{Binding UpdatedAt, TargetNullValue=False}"
                               Style="{StaticResource CaptionLabel}" />

                        <!-- D25.1 бейджи -->
                        <Label Text="✓ Юзер закрепил решение"
                               TextColor="#2E7D32"
                               FontAttributes="Bold"
                               IsVisible="{Binding AcceptedByUser}" />
                        <Label Text="{Binding ReopenedHistoryText}"
                               TextColor="#C0392B"
                               FontAttributes="Bold"
                               IsVisible="{Binding HasReopenedHistory}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Пользователь — тап открывает админ-страницу профиля -->
                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding HasUser}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Пользователь"
                               Style="{StaticResource SubTitleLabel}" />
                        <Button Text="{Binding UserButtonLabel}"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding OpenUserCommand}"
                                HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>

                <!-- D34. Если тикет создан с карточки умершего — кнопка
                     быстрого перехода. Парсится из Description маркером
                     "ID карточки: {guid}". -->
                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding HasDeceasedRef}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Связанная карточка умершего"
                               Style="{StaticResource SubTitleLabel}" />
                        <Label Text="Это обращение пришло из карточки умершего. Открыть карточку?"
                               Style="{StaticResource CaptionLabel}" />
                        <Button Text="Открыть карточку"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding OpenDeceasedCommand}"
                                HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>

                <!-- Описание -->
                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Описание"
                               Style="{StaticResource SubTitleLabel}" />
                        <Label Text="{Binding Description}"
                               Style="{StaticResource BodyLabel}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Details (для auto-инцидентов: external_payment_id и т.п.) -->
                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding HasDetails}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Технические детали"
                               Style="{StaticResource SubTitleLabel}" />
                        <Label Text="{Binding Details}"
                               FontFamily="Courier New"
                               FontSize="12"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- D33. Вложения от юзера. Тап — открывает файл в браузере
                     (presigned URL). Браузер сам решает: фото / PDF
                     показать inline, или предложить скачать на устройство. -->
                <Label Text="Вложения"
                       Style="{StaticResource SubTitleLabel}"
                       Margin="4,8,0,0"
                       IsVisible="{Binding HasAttachments}" />

                <CollectionView ItemsSource="{Binding Attachments}"
                                SelectionMode="None"
                                IsVisible="{Binding HasAttachments}"
                                x:Name="AttachmentsList">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vmsup:AttachmentDisplayItem">
                            <Border WidthRequest="100"
                                    HeightRequest="120"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Sky}"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <!-- D35. Тап показывает ActionSheet:
                                     "Открыть на весь экран" / "Сделать
                                     главным фото умершего" (если есть
                                     DeceasedRefId и это фото). -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference AttachmentsList}, Path=BindingContext.PhotoLongPressCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="*,Auto">
                                    <Label Grid.Row="0"
                                           FontSize="36"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsImage}"
                                                         Value="True">
                                                <Setter Property="Text" Value="🖼" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsImage}"
                                                         Value="False">
                                                <Setter Property="Text" Value="📄" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Row="1"
                                           Text="{Binding SizeLabel}"
                                           FontSize="10"
                                           TextColor="{StaticResource Azure}"
                                           HorizontalOptions="Center"
                                           Padding="2,4" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- D25.2. Полная переписка. Для админа: свои (Admin)
                     белые справа, юзер (User) жёлтые слева. -->
                <Label Text="Переписка"
                       Style="{StaticResource SubTitleLabel}"
                       Margin="4,8,0,0"
                       IsVisible="{Binding HasChatMessages}" />

                <CollectionView ItemsSource="{Binding ChatMessages}"
                                SelectionMode="None"
                                IsVisible="{Binding HasChatMessages}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vmsup:ChatMessage">
                            <Border BackgroundColor="{Binding BackgroundColor}"
                                    Stroke="#E0E0E0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12"
                                    Margin="0,0,0,8"
                                    HorizontalOptions="{Binding HorizontalOptions}"
                                    MaximumWidthRequest="320">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding AuthorLabel}"
                                           TextColor="{Binding LabelColor}"
                                           FontAttributes="Bold"
                                           FontSize="13" />
                                    <Label Text="{Binding Text}"
                                           Style="{StaticResource BodyLabel}"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="{Binding CreatedAt}"
                                           Style="{StaticResource CaptionLabel}"
                                           FontSize="11" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Смена статуса (скрыта если уже Resolved) -->
                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding IsResolved, Converter={StaticResource InvertedBool}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Сменить статус"
                               Style="{StaticResource SubTitleLabel}" />
                        <Picker ItemsSource="{Binding StatusOptions}"
                                SelectedItem="{Binding SelectedStatusOption}" />

                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding IsResolveSelected}">
                            <Label Text="Резолюция (что сделано)" Style="{StaticResource CaptionLabel}" />
                            <Editor Placeholder="Например: выдан compli-доступ на 30 дней"
                                    MaxLength="4000"
                                    HeightRequest="120"
                                    AutoSize="TextChanges"
                                    Text="{Binding NewResolutionNote}" />
                        </VerticalStackLayout>

                        <Button Text="Сохранить статус"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveStatusCommand}"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBool}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Смена severity (скрыта если уже Resolved — бэк не пустит) -->
                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding IsResolved, Converter={StaticResource InvertedBool}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Сменить приоритет"
                               Style="{StaticResource SubTitleLabel}" />
                        <Picker ItemsSource="{Binding SeverityOptions}"
                                SelectedItem="{Binding SelectedSeverityOption}" />
                        <Button Text="Сохранить приоритет"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveSeverityCommand}"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource InvertedBool}}" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsSaving}"
                                   IsVisible="{Binding IsSaving}"
                                   Color="{StaticResource Azure}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

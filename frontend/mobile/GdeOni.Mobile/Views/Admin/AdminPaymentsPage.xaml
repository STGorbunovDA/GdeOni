<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             x:Class="GdeOni.Mobile.Views.Admin.AdminPaymentsPage"
             x:DataType="vm:AdminPaymentsViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Платежи">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,40" Spacing="14">

                <Button Text="‹ Назад"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"
                        Padding="16,8" />

                <Label Text="Платежи" Style="{StaticResource TitleLabel}" />
                <Label Text="Все платежи подписок по системе." Style="{StaticResource CaptionLabel}" />

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Фильтры" Style="{StaticResource SubTitleLabel}" FontSize="15" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Статус:"
                                   Style="{StaticResource CaptionLabel}"
                                   VerticalOptions="Center" />
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding StatusFilterOptions}"
                                    SelectedItem="{Binding SelectedStatusFilter}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   Placeholder="Поиск по email юзера"
                                   Text="{Binding EmailSearch}" />
                            <Button Grid.Column="1"
                                    Text="Найти"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,6"
                                    Command="{Binding ApplyEmailSearchCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Фильтр по дате создания"
                                   Style="{StaticResource CaptionLabel}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsDateFilterEnabled}"
                                    OnColor="{StaticResource Azure}" />
                        </Grid>

                        <VerticalStackLayout IsVisible="{Binding IsDateFilterEnabled}" Spacing="6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="От:"
                                       Style="{StaticResource CaptionLabel}"
                                       VerticalOptions="Center" />
                                <DatePicker Grid.Column="1"
                                            Date="{Binding CreatedFrom}"
                                            MaximumDate="{Binding CreatedTo}"
                                            Format="dd.MM.yyyy" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="До:"
                                       Style="{StaticResource CaptionLabel}"
                                       VerticalOptions="Center" />
                                <DatePicker Grid.Column="1"
                                            Date="{Binding CreatedTo}"
                                            MinimumDate="{Binding CreatedFrom}"
                                            Format="dd.MM.yyyy" />
                            </Grid>
                        </VerticalStackLayout>

                        <Button Text="Сбросить фильтры"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ClearFiltersCommand}"
                                HorizontalOptions="End"
                                Padding="14,6"
                                FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding TotalCount, StringFormat='Всего: {0}'}"
                       Style="{StaticResource CaptionLabel}" />

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Azure}" />

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="#C0392B"
                       Style="{StaticResource BodyLabel}" />

                <Label Text="Платежей нет."
                       Style="{StaticResource CaptionLabel}"
                       IsVisible="{Binding HasNoItems}" />

                <CollectionView ItemsSource="{Binding Payments}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdminPaymentEntry">
                            <Border Style="{StaticResource CloudCard}" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" RowSpacing="2">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding UserEmail}"
                                               Style="{StaticResource SubTitleLabel}"
                                               FontSize="15" />
                                        <Label Text="{Binding CreatedAt}" Style="{StaticResource CaptionLabel}" />
                                        <Label Text="{Binding Period, StringFormat='Период: {0}'}" Style="{StaticResource CaptionLabel}" />
                                        <Label Text="{Binding Plan, StringFormat='План: {0}'}" Style="{StaticResource CaptionLabel}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                        <Label Text="{Binding Amount}"
                                               Style="{StaticResource SubTitleLabel}"
                                               FontSize="15" />
                                        <Label Text="{Binding StatusDisplay}"
                                               TextColor="{Binding StatusColor}"
                                               FontAttributes="Bold"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Загрузить ещё"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding LoadNextPageCommand}"
                        IsVisible="{Binding CanLoadMore}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

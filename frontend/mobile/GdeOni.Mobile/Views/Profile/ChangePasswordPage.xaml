<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             x:Class="GdeOni.Mobile.Views.Profile.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Сменить пароль">

    <Grid>
        <Ellipse Fill="White"
                 Opacity="0.45"
                 WidthRequest="240"
                 HeightRequest="130"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 TranslationX="60"
                 TranslationY="40" />

        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,40" Spacing="16">

                <Button Text="‹ Назад"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding CancelCommand}"
                        HorizontalOptions="Start"
                        Padding="16,8"
                        FontSize="14" />

                <Label Text="Сменить пароль"
                       Style="{StaticResource TitleLabel}" />

                <Label Text="После смены пароля вы будете автоматически разлогинены — все устройства потребуют повторный вход."
                       Style="{StaticResource BodyLabel}" />

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Текущий пароль"
                               Style="{StaticResource CaptionLabel}" />
                        <Entry Text="{Binding CurrentPassword, Mode=TwoWay}"
                               IsPassword="True"
                               Placeholder="••••••••"
                               Style="{StaticResource FormEntry}" />

                        <Label Text="Новый пароль"
                               Style="{StaticResource CaptionLabel}" />
                        <Entry Text="{Binding NewPassword, Mode=TwoWay}"
                               IsPassword="True"
                               Placeholder="Минимум 8 символов"
                               Style="{StaticResource FormEntry}" />

                        <Label IsVisible="{Binding IsNewPasswordTooShort}"
                               Text="Пароль должен быть минимум 8 символов."
                               TextColor="#C77B00"
                               FontSize="12" />
                        <Label IsVisible="{Binding IsNewPasswordTooLong}"
                               Text="Пароль слишком длинный (максимум 128 символов)."
                               TextColor="#C77B00"
                               FontSize="12" />

                        <Label Text="Повторите новый пароль"
                               Style="{StaticResource CaptionLabel}" />
                        <Entry Text="{Binding ConfirmPassword, Mode=TwoWay}"
                               IsPassword="True"
                               Placeholder="То же что и выше"
                               Style="{StaticResource FormEntry}" />
                    </VerticalStackLayout>
                </Border>

                <Label IsVisible="{Binding HasError}"
                       Text="{Binding ErrorMessage}"
                       TextColor="#C0392B"
                       FontSize="13" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Azure}" />

                <Button Text="Сменить пароль"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SubmitCommand}"
                        IsEnabled="{Binding CanSubmit}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

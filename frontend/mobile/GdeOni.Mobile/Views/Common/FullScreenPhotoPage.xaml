<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GdeOni.Mobile.Views.Common.FullScreenPhotoPage"
             x:Name="Page"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid>
        <!-- Тап по фону закрывает страницу — естественный способ
             выйти из полноэкранного просмотра без отдельной кнопки. -->
        <Image x:Name="Photo"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseTapped" />
            </Image.GestureRecognizers>
        </Image>

        <!-- Кнопка-крестик в правом верхнем углу — на случай если
             пользователь не догадается тапнуть по фото. -->
        <Button Text="✕"
                BackgroundColor="#80000000"
                TextColor="White"
                FontSize="20"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,40,16,0"
                Clicked="OnCloseTapped" />
    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GdeOni.Mobile.Views.Common.PdfPreviewPage"
             x:Name="Page"
             BackgroundColor="#1a1a1a"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Просмотр документа">

    <Grid RowDefinitions="Auto,*">
        <!-- Header с кнопкой закрыть. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              BackgroundColor="#1a1a1a"
              Padding="16,40,16,12">
            <Label Grid.Column="0"
                   x:Name="FileNameLabel"
                   Text="Документ"
                   TextColor="White"
                   FontSize="16"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
            <Button Grid.Column="1"
                    Text="✕"
                    BackgroundColor="#80000000"
                    TextColor="White"
                    FontSize="20"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    Clicked="OnCloseTapped" />
        </Grid>

        <!-- Android Chrome WebView рендерит PDF inline начиная с Android 13+
             (Google Chrome 99+). На более старых версиях покажется
             ссылка с кнопкой "Открыть в браузере" — fallback внутри
             OnNavigating если это понадобится позже. -->
        <WebView Grid.Row="1"
                 x:Name="Web"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill" />

        <ActivityIndicator Grid.Row="1"
                           x:Name="Spinner"
                           IsRunning="True"
                           IsVisible="True"
                           Color="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>

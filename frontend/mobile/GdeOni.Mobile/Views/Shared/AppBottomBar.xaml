<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GdeOni.Mobile.Views.Shared.AppBottomBar">

    <Grid>
        <Border BackgroundColor="{StaticResource Cloud}"
                StrokeThickness="0"
                Margin="16,0,16,16"
                Padding="8">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="32" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource InkBlueBrush}"
                        Offset="0,4"
                        Radius="14"
                        Opacity="0.12" />
            </Border.Shadow>

            <Grid ColumnDefinitions="*,*,*"
                  HeightRequest="60">

                <!-- Отслеживаемые -->
                <Button x:Name="TabTracked"
                        Grid.Column="0"
                        Text="Отслеживаемые"
                        Clicked="OnTrackedTapped"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#9AA8B5"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CornerRadius="24"
                        Padding="0" />

                <!-- Маршрут -->
                <Button x:Name="TabRoute"
                        Grid.Column="1"
                        Text="Маршрут"
                        Clicked="OnRouteTapped"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#9AA8B5"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CornerRadius="24"
                        Padding="0" />

                <!-- Профиль -->
                <Button x:Name="TabProfile"
                        Grid.Column="2"
                        Text="Профиль"
                        Clicked="OnProfileTapped"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#9AA8B5"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CornerRadius="24"
                        Padding="0" />
            </Grid>
        </Border>
    </Grid>

</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             x:Class="GdeOni.Mobile.Views.Support.SupportMinePage"
             x:DataType="vm:SupportMineViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Мои обращения">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,40" Spacing="14">

                <Button Text="‹ Назад"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"
                        Padding="16,8" />

                <Label Text="Мои обращения" Style="{StaticResource TitleLabel}" />
                <Label Text="История ваших обращений и ответы администратора."
                       Style="{StaticResource CaptionLabel}" />

                <Button Text="+ Новое обращение"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewCommand}"
                        HorizontalOptions="Fill" />

                <Label Text="{Binding TotalCount, StringFormat='Всего: {0}'}"
                       Style="{StaticResource CaptionLabel}" />

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Azure}" />

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="#C0392B"
                       Style="{StaticResource BodyLabel}" />

                <Label Text="Пока нет обращений."
                       Style="{StaticResource CaptionLabel}"
                       IsVisible="{Binding HasNoItems}" />

                <CollectionView ItemsSource="{Binding Tickets}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SupportTicketEntry">
                            <Border Style="{StaticResource CloudCard}" Margin="0,0,0,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SupportMineViewModel}}, Path=OpenCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding Title}"
                                               Style="{StaticResource SubTitleLabel}"
                                               FontSize="15"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1"
                                               Text="{Binding SeverityDisplay}"
                                               TextColor="{Binding SeverityColor}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding KindDisplay}"
                                               Style="{StaticResource CaptionLabel}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding StatusDisplay}"
                                               TextColor="{Binding StatusColor}"
                                               FontAttributes="Bold" />
                                    </Grid>
                                    <Label Text="{Binding CreatedAt}" Style="{StaticResource CaptionLabel}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Загрузить ещё"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding LoadNextPageCommand}"
                        IsVisible="{Binding CanLoadMore}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

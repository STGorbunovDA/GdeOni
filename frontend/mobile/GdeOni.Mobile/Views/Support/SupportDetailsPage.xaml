<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             x:Class="GdeOni.Mobile.Views.Support.SupportDetailsPage"
             x:DataType="vm:SupportDetailsViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Обращение">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,40" Spacing="14">

                <Button Text="‹ Назад"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"
                        Padding="16,8" />

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Azure}" />

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="#C0392B"
                       Style="{StaticResource BodyLabel}" />

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Title}"
                               Style="{StaticResource TitleLabel}"
                               FontSize="20" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding KindDisplay}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding SeverityDisplay}"
                                   TextColor="{Binding SeverityColor}"
                                   FontAttributes="Bold" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding CreatedAt}"
                                   Style="{StaticResource CaptionLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding StatusDisplay}"
                                   TextColor="{Binding StatusColor}"
                                   FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Описание"
                               Style="{StaticResource SubTitleLabel}" />
                        <Label Text="{Binding Description}"
                               Style="{StaticResource BodyLabel}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CloudCard}"
                        IsVisible="{Binding HasResolution}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Ответ администратора"
                               Style="{StaticResource SubTitleLabel}" />
                        <Label Text="{Binding ResolutionNote}"
                               Style="{StaticResource BodyLabel}"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding ResolvedAt, StringFormat='Закрыто: {0}'}"
                               Style="{StaticResource CaptionLabel}"
                               IsVisible="{Binding ResolvedAt, TargetNullValue=False}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

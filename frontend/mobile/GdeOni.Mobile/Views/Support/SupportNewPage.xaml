<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GdeOni.Mobile.ViewModels"
             x:Name="Page"
             x:Class="GdeOni.Mobile.Views.Support.SupportNewPage"
             x:DataType="vm:SupportNewViewModel"
             Style="{StaticResource CloudPage}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Новое обращение">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,40,24,40" Spacing="16">

                <Button Text="‹ Назад"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"
                        Padding="16,8" />

                <Label Text="Новое обращение" Style="{StaticResource TitleLabel}" />
                <Label Text="Опишите проблему — администратор ответит в разделе «Мои обращения»."
                       Style="{StaticResource CaptionLabel}" />

                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Тема обращения" Style="{StaticResource CaptionLabel}" />
                        <Picker ItemsSource="{Binding KindOptions}"
                                ItemDisplayBinding="{Binding Display}"
                                SelectedItem="{Binding SelectedKind}"
                                Title="Выберите тему" />

                        <Label Text="Заголовок" Style="{StaticResource CaptionLabel}" />
                        <Entry Placeholder="Кратко опишите проблему"
                               MaxLength="200"
                               Text="{Binding Title}" />

                        <Label Text="Описание" Style="{StaticResource CaptionLabel}" />
                        <Editor Placeholder="Подробное описание (что произошло, ожидаемый результат)"
                                MaxLength="4000"
                                HeightRequest="180"
                                AutoSize="TextChanges"
                                Text="{Binding Description}" />
                    </VerticalStackLayout>
                </Border>

                <!-- D33. Вложения — до 5 файлов (JPEG/PNG/PDF). -->
                <Border Style="{StaticResource CloudCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Файлы" Style="{StaticResource CaptionLabel}" />
                        <Label Text="Прикрепите фото или PDF, чтобы помочь администратору быстрее разобраться. Максимум 5 файлов."
                               Style="{StaticResource CaptionLabel}"
                               FontSize="12" />

                        <Button Text="{Binding AttachmentsLabel}"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding PickAttachmentCommand}"
                                HorizontalOptions="Fill" />

                        <CollectionView ItemsSource="{Binding Attachments}"
                                        IsVisible="{Binding HasAttachments}"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PickedAttachment">
                                    <Border WidthRequest="100"
                                            HeightRequest="120"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource Sky}, Dark={StaticResource SkyDark}}"
                                            Padding="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Grid RowDefinitions="*,Auto">

                                            <!-- Превью: для PDF — иконка; для фото оставляем место (превью
                                                 байтов в MAUI требует platform-specific подгрузки, обходимся
                                                 названием файла снизу). -->
                                            <Grid Grid.Row="0">
                                                <Label FontSize="36"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsImage}"
                                                                     Value="True">
                                                            <Setter Property="Text" Value="🖼" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsImage}"
                                                                     Value="False">
                                                            <Setter Property="Text" Value="📄" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Grid>

                                            <Label Grid.Row="1"
                                                   Text="{Binding SizeLabel}"
                                                   FontSize="10"
                                                   TextColor="{StaticResource Azure}"
                                                   HorizontalOptions="Center"
                                                   Padding="2,4" />

                                            <!-- Кнопка удаления вложения. -->
                                            <Button Grid.Row="0"
                                                    Text="✕"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="#C0392B"
                                                    TextColor="White"
                                                    CornerRadius="12"
                                                    WidthRequest="24"
                                                    HeightRequest="24"
                                                    Padding="0"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start"
                                                    Margin="0,4,4,0"
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.RemoveAttachmentCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="#C0392B"
                       Style="{StaticResource BodyLabel}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Azure}" />

                <Button Text="Отправить"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SubmitCommand}"
                        HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

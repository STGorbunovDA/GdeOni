<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Палитра в стиле шаблона Medilab (зеркало web: src/design/theme.ts).
         Ключи оставлены прежними — меняются только значения, поэтому всё
         приложение перекрашивается разом, без правки XAML-страниц.

         accent  #1977CC → Azure       (кнопки, активное, акценты)
         heading #2C4964 → InkBlue     (заголовки)
         text    #444444 → TextBody    (основной текст)
         bg      #F1F7FC → Mist        (фон страниц)
         surface #FFFFFF → Cloud       (карточки) -->
    <Color x:Key="Cloud">#FFFFFF</Color>
    <Color x:Key="Sky">#E8F2FB</Color>
    <Color x:Key="Mist">#F1F7FC</Color>
    <Color x:Key="Azure">#1977CC</Color>
    <Color x:Key="AzureDeep">#145A9E</Color>
    <Color x:Key="InkBlue">#2C4964</Color>
    <Color x:Key="TextBody">#444444</Color>
    <Color x:Key="CaptionGray">#7A8794</Color>
    <Color x:Key="CloudBorder">#E2ECF5</Color>

    <!-- E27. Тёмные варианты семантических токенов (зеркало web
         styles.css [data-mantine-color-scheme='dark'] / theme.ts dark[]).
         Токены СЕМАНТИЧЕСКИЕ: Cloud — «поверхность карточки», в тёмной теме
         она тёмно-синяя, а не белая; InkBlue — «цвет заголовка», в тёмной
         теме светлый. Применяются через AppThemeBinding в Styles.xaml и на
         страницах, переключаются вместе с Application.UserAppTheme.
         Azure (акцент) намеренно без тёмного варианта — #1977CC читается на
         обоих фонах, отдельный оттенок только плодил бы правки. -->
    <Color x:Key="CloudDark">#16202B</Color>
    <Color x:Key="SkyDark">#223243</Color>
    <Color x:Key="MistDark">#0F1720</Color>
    <Color x:Key="AzureDeepDark">#6FAAE5</Color>
    <Color x:Key="InkBlueDark">#E6EDF3</Color>
    <Color x:Key="TextBodyDark">#C2CCD6</Color>
    <Color x:Key="CaptionGrayDark">#8A99A8</Color>
    <Color x:Key="CloudBorderDark">#3A4A5A</Color>

    <SolidColorBrush x:Key="CloudBrush" Color="{StaticResource Cloud}"/>
    <SolidColorBrush x:Key="SkyBrush" Color="{StaticResource Sky}"/>
    <SolidColorBrush x:Key="AzureBrush" Color="{StaticResource Azure}"/>
    <SolidColorBrush x:Key="InkBlueBrush" Color="{StaticResource InkBlue}"/>
    <SolidColorBrush x:Key="MistBrush" Color="{StaticResource Mist}"/>
    <!-- Тень карточек в шаблоне — нейтральная чёрная 10%, не синяя. -->
    <SolidColorBrush x:Key="ShadowBrush" Color="#000000"/>

    <Color x:Key="Primary">#1977CC</Color>
    <Color x:Key="PrimaryDark">#145A9E</Color>
    <Color x:Key="PrimaryDarkText">#2C4964</Color>
    <Color x:Key="Secondary">#E8F2FB</Color>
    <Color x:Key="SecondaryDarkText">#2C4964</Color>
    <Color x:Key="Tertiary">#2C4964</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
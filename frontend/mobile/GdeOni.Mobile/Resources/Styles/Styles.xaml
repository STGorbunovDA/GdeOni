    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource Cloud}, Dark={StaticResource CloudDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource InkBlue}, Dark={StaticResource InkBlueDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource InkBlue}, Dark={StaticResource InkBlueDark}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource CloudBorder}, Dark={StaticResource CloudBorderDark}}" />
        <Setter Property="Shell.UnselectedColor" Value="#9AA8B5" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource Cloud}, Dark={StaticResource CloudDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Azure}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Azure}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="#9AA8B5" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>

    <!--
    ===============================================================
    GdeOni cloud-themed design system (E3)
    ===============================================================
    -->

    <!-- Оставлен для обратной совместимости, если где-то понадобится градиент. -->
    <LinearGradientBrush x:Key="CloudGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Cloud}" Offset="0" />
        <GradientStop Color="{StaticResource Sky}" Offset="1" />
    </LinearGradientBrush>

    <!-- Базовый стиль ContentPage: ровный светлый фон #F1F7FC, как
         .light-background в шаблоне Medilab (градиент убран — на вебе фон
         тоже плоский, держим паритет). -->
    <Style x:Key="CloudPage" TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Mist}, Dark={StaticResource MistDark}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Заголовок страницы (Montserrat Bold, heading-color). -->
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="MontserratBold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkBlue}, Dark={StaticResource InkBlueDark}}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Подзаголовок секции (Montserrat SemiBold). -->
    <Style x:Key="SubTitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Montserrat" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkBlue}, Dark={StaticResource InkBlueDark}}" />
    </Style>

    <!-- Основной текст (Roboto, #444444). -->
    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextBody}, Dark={StaticResource TextBodyDark}}" />
        <Setter Property="LineHeight" Value="1.4" />
    </Style>

    <!-- Подпись/меньший текст. -->
    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource CaptionGray}, Dark={StaticResource CaptionGrayDark}}" />
    </Style>

    <!-- Карточка в стиле Medilab: скругление 10, нейтральная тень 10%,
         без рамки (глубину даёт только тень). -->
    <Style x:Key="CloudCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Cloud}, Dark={StaticResource CloudDark}}" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="10" />
        </Setter>
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Shadow">
            <Shadow Brush="{StaticResource ShadowBrush}"
                    Offset="0,2"
                    Radius="15"
                    Opacity="0.1" />
        </Setter>
    </Style>

    <!-- Главная кнопка Medilab (.cta-btn): accent-заливка, «пилюля». -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Azure}" />
        <Setter Property="TextColor" Value="{StaticResource Cloud}" />
        <Setter Property="FontFamily" Value="RobotoBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="50" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource AzureDeep}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CloudBorder}, Dark={StaticResource CloudBorderDark}}" />
                            <Setter Property="TextColor" Value="#9AA8B5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Вторичная кнопка: прозрачный фон, accent-бордер и текст, «пилюля». -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Azure}" />
        <Setter Property="BorderColor" Value="{StaticResource Azure}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="RobotoBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="50" />
        <Setter Property="Padding" Value="24,14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Sky}, Dark={StaticResource SkyDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Поле формы: белая подложка, текст #444444. -->
    <Style x:Key="FormEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Cloud}, Dark={StaticResource CloudDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextBody}, Dark={StaticResource TextBodyDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource CaptionGray}, Dark={StaticResource CaptionGrayDark}}" />
        <Setter Property="FontFamily" Value="Roboto" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

</ResourceDictionary>
